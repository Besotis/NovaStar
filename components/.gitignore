*.py[cod]

# VS Code local settings (keep recommended extensions)
.vscode/*
!.vscode/extensions.json

# macOS
.DS_Store
._*
.Spotlight-V100/
.Trashes/

# Editor temp files
*.swp
*.swo
*~

# Keep tracked source, component manifests, and reproducible config:
# components/, main/, CMakeLists.txt, idf_component.yml,
# sdkconfig.defaults, dependencies.lock