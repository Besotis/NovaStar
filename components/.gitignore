# ESP-IDF generated build outputs
/build/
/build-*/
/sdkconfig
/sdkconfig.old
/sdkconfig.*.old

# ESP-IDF Component Manager downloads (including LVGL)
/managed_components/

# ESP-IDF local configuration and caches
/.idf_component_manager/
/.cache/

# Python environments and caches
/.venv/
/venv/
